generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  requester
  developer
  agent
  cto_agent
}

enum InternalRole {
  cto
  pm
  developer
  tester
  security
  ops
  qa
}

enum OkrRole {
  okr_owner
  okr_admin
  okr_reviewer
  okr_member
  okr_viewer
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  email          String          @unique
  password       String
  role           UserRole        @default(requester)
  internalRole   InternalRole?   @map("internal_role")
  okrRole        OkrRole         @default(okr_member) @map("okr_role")
  agentId        String?         @unique
  permissions    Json            @default("[]")
  bio            String?
  phone          String?
  avatar         String?
  department     String?
  title          String?
  employeeNo     String?         @unique
  onboardingDate DateTime?
  managerId      String?         @db.Uuid
  status         PrincipalStatus @default(active)
  updatedAt      DateTime        @updatedAt @map("updated_at")
  disabledAt     DateTime?       @map("disabled_at")

  createdAt DateTime @default(now())

  machinePrincipals         MachinePrincipal[]
  authorizationTransactions AuthorizationTransaction[]
  authorizationCodes        AuthorizationCode[]
  humanSessions             HumanSession[]
  refreshCredentials        RefreshCredential[]
  canonicalSubjectAttestations CanonicalSubjectAttestation[] @relation("CanonicalSubjectHuman")
  submittedSubjectAttestations CanonicalSubjectAttestation[] @relation("CanonicalSubjectAttestedByUser")
  identityAttestationDelegations IdentityAttestationDelegation[]

  @@map("users")
}

enum ServiceRegistrationStatus {
  active
  inactive
}

model ServiceRegistration {
  id           String                    @id @default(uuid()) @db.Uuid
  serviceName  String                    @unique @map("service_name") // e.g. "agent-dev-center", "llm-wiki"
  displayName  String                    @map("display_name") // e.g. "ADC 需求平台"
  jwtAudience  String                    @unique @map("jwt_audience") // e.g. "adc-api", "llm-wiki-api"
  allowedRoles String                    @default("admin,developer,agent,requester") @map("allowed_roles") // comma-separated
  serviceUrl   String?                   @map("service_url") // e.g. "http://localhost:4000"
  apiPublicKey String?                   @map("api_public_key") // future: per-service key
  status       ServiceRegistrationStatus @default(active)
  description  String?
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  @@map("service_registrations")
}

enum PrincipalType {
  agent
  service
}

enum PrincipalStatus {
  active
  disabled
}

enum ClientStatus {
  active
  revoked
}

model MachinePrincipal {
  id            String          @id @default(uuid()) @db.Uuid
  principalType PrincipalType   @default(agent) @map("principal_type")
  agentId       String?         @unique @map("agent_id")
  ownerUserId   String?         @map("owner_user_id") @db.Uuid
  displayName   String?         @map("display_name")
  externalRef   String?         @unique @map("external_ref")
  requestDigest String?         @map("request_digest")
  status        PrincipalStatus @default(active)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  disabledAt    DateTime?       @map("disabled_at")

  owner        User?           @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  identityLifecycle AgentIdentityLifecycle?
  identitySuccessor AgentIdentitySuccessor? @relation("IdentitySource")
  identityPredecessors AgentIdentitySuccessor[] @relation("IdentityTarget")
  clients      MachineClient[]
  trustedProxy TrustedProxy?   @relation("ProxyPrincipal")
  canonicalSubjectAttestations CanonicalSubjectAttestation[] @relation("CanonicalSubjectMachine")
  submittedSubjectAttestations CanonicalSubjectAttestation[] @relation("CanonicalSubjectAttestedByMachine")
  identityAttestationDelegations IdentityAttestationDelegation[]

  @@map("machine_principals")
}

model MachineClient {
  id                 String       @id @default(uuid()) @db.Uuid
  clientId           String       @unique @map("client_id")
  machinePrincipalId String       @map("machine_principal_id") @db.Uuid
  secretHash         String       @map("secret_hash")
  externalRef        String?      @unique @map("external_ref")
  status             ClientStatus @default(active)
  allowedResources   String[]     @map("allowed_resources")
  allowedScopes      String[]     @map("allowed_scopes")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  rotatedAt          DateTime?    @map("rotated_at")
  revokedAt          DateTime?    @map("revoked_at")

  principal    MachinePrincipal     @relation(fields: [machinePrincipalId], references: [id])
  accessGrants MachineAccessGrant[]
  trustedProxy TrustedProxy?        @relation("ProxyClient")

  @@map("machine_clients")
}

enum AudienceStatus {
  candidate
  active
  disabled
  retired
}

enum HumanClientType {
  confidential_web
  public_browser
  native
}
enum HumanClientAuthenticationMethod {
  none
  client_secret_basic
}
enum HumanClientStatus {
  active
  revoked
}
enum AuthorizationTransactionStatus {
  pending
  authenticated
  consumed
  expired
}
enum AuthorizationCodeStatus {
  active
  consumed
  expired
}
enum HumanSessionStatus {
  active
  revoked
  expired
}
enum RefreshFamilyStatus {
  active
  revoked
  expired
}
enum RefreshCredentialStatus {
  active
  rotated
  revoked
  expired
}
enum ExchangeAuditResult {
  success
  rejected
}
enum GrantChangeType {
  create
  replace
  revoke
}
model AuthAudience {
  audienceId             String         @id @map("audience_id")
  resourceService        String         @map("resource_service")
  scopeNamespace         String         @map("scope_namespace")
  acceptedPrincipalTypes String[]       @map("accepted_principal_types")
  registeredScopes       String[]       @map("registered_scopes")
  humanAccessEnabled     Boolean        @map("human_access_enabled")
  machineAccessEnabled   Boolean        @map("machine_access_enabled")
  delegatedAccessEnabled Boolean        @map("delegated_access_enabled")
  status                 AudienceStatus @default(candidate)
  freezeReady            Boolean        @default(false) @map("freeze_ready")
  version                Int            @default(1)
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  humanGrants               HumanAudienceGrant[]
  machineGrants             MachineAccessGrant[]
  acceptedByProxies         ProxyAcceptedSubjectAudience[]
  delegationGrants          DelegationGrant[]
  authorizationTransactions AuthorizationTransaction[]
  authorizationCodes        AuthorizationCode[]

  @@map("auth_audiences")
}

model HumanClient {
  id                         String                          @id @default(uuid()) @db.Uuid
  clientId                   String                          @unique @map("client_id")
  clientType                 HumanClientType                 @map("client_type")
  clientAuthenticationMethod HumanClientAuthenticationMethod @map("client_authentication_method")
  credentialVerifier         String?                         @map("credential_verifier")
  status                     HumanClientStatus               @default(active)
  version                    Int                             @default(1)
  createdAt                  DateTime                        @default(now()) @map("created_at")
  updatedAt                  DateTime                        @updatedAt @map("updated_at")
  revokedAt                  DateTime?                       @map("revoked_at")

  redirectUris              HumanClientRedirectUri[]
  audienceGrants            HumanAudienceGrant[]
  authorizationTransactions AuthorizationTransaction[]
  authorizationCodes        AuthorizationCode[]
  humanSessions             HumanSession[]
  refreshCredentials        RefreshCredential[]

  @@map("human_clients")
}

model HumanClientRedirectUri {
  humanClientId String      @map("human_client_id") @db.Uuid
  redirectUri   String      @map("redirect_uri")
  createdAt     DateTime    @default(now()) @map("created_at")
  humanClient   HumanClient @relation(fields: [humanClientId], references: [id])

  @@id([humanClientId, redirectUri])
  @@map("human_client_redirect_uris")
}

model HumanAudienceGrant {
  humanClientId String       @map("human_client_id") @db.Uuid
  audienceId    String       @map("audience_id")
  version       Int          @default(1)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  humanClient   HumanClient  @relation(fields: [humanClientId], references: [id])
  audience      AuthAudience @relation(fields: [audienceId], references: [audienceId])

  @@id([humanClientId, audienceId])
  @@map("human_audience_grants")
}

model MachineAccessGrant {
  machineClientId String        @map("machine_client_id") @db.Uuid
  audienceId      String        @map("audience_id")
  scopes          String[]
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  machineClient   MachineClient @relation(fields: [machineClientId], references: [id])
  audience        AuthAudience  @relation(fields: [audienceId], references: [audienceId])

  @@id([machineClientId, audienceId])
  @@map("machine_access_grants")
}

model TrustedProxy {
  id                String                         @id @default(uuid()) @db.Uuid
  proxyPrincipalId  String                         @unique @map("proxy_principal_id") @db.Uuid
  proxyClientId     String                         @unique @map("proxy_client_id") @db.Uuid
  status            ClientStatus                   @default(active)
  version           Int                            @default(1)
  createdAt         DateTime                       @default(now()) @map("created_at")
  updatedAt         DateTime                       @updatedAt @map("updated_at")
  revokedAt         DateTime?                      @map("revoked_at")
  proxyPrincipal    MachinePrincipal               @relation("ProxyPrincipal", fields: [proxyPrincipalId], references: [id])
  proxyClient       MachineClient                  @relation("ProxyClient", fields: [proxyClientId], references: [id])
  acceptedAudiences ProxyAcceptedSubjectAudience[]
  delegationGrants  DelegationGrant[]

  @@map("trusted_proxies")
}

model ProxyAcceptedSubjectAudience {
  trustedProxyId String       @map("trusted_proxy_id") @db.Uuid
  audienceId     String       @map("audience_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  trustedProxy   TrustedProxy @relation(fields: [trustedProxyId], references: [id])
  audience       AuthAudience @relation(fields: [audienceId], references: [audienceId])

  @@id([trustedProxyId, audienceId])
  @@map("proxy_accepted_subject_audiences")
}

model DelegationGrant {
  trustedProxyId String       @map("trusted_proxy_id") @db.Uuid
  audienceId     String       @map("audience_id")
  scopes         String[]
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  trustedProxy   TrustedProxy @relation(fields: [trustedProxyId], references: [id])
  audience       AuthAudience @relation(fields: [audienceId], references: [audienceId])

  @@id([trustedProxyId, audienceId])
  @@map("delegation_grants")
}

model AuthorizationTransaction {
  id                  String                         @id @default(uuid()) @db.Uuid
  humanClientId       String                         @map("human_client_id") @db.Uuid
  audienceId          String                         @map("audience_id")
  redirectUri         String                         @map("redirect_uri")
  state               String
  codeChallenge       String                         @map("code_challenge")
  codeChallengeMethod String                         @default("S256") @map("code_challenge_method")
  authenticatedUserId String?                        @map("authenticated_user_id") @db.Uuid
  status              AuthorizationTransactionStatus @default(pending)
  createdAt           DateTime                       @default(now()) @map("created_at")
  expiresAt           DateTime                       @map("expires_at")
  consumedAt          DateTime?                      @map("consumed_at")
  version             Int                            @default(1)
  humanClient         HumanClient                    @relation(fields: [humanClientId], references: [id])
  audience            AuthAudience                   @relation(fields: [audienceId], references: [audienceId])
  authenticatedUser   User?                          @relation(fields: [authenticatedUserId], references: [id])
  authorizationCode   AuthorizationCode?

  @@index([humanClientId, status, expiresAt])
  @@map("authorization_transactions")
}

model AuthorizationCode {
  id                         String                   @id @default(uuid()) @db.Uuid
  credentialVerifier         String                   @map("credential_verifier")
  verifierParametersVersion  String                   @map("verifier_parameters_version")
  authorizationTransactionId String                   @unique @map("authorization_transaction_id") @db.Uuid
  userId                     String                   @map("user_id") @db.Uuid
  humanClientId              String                   @map("human_client_id") @db.Uuid
  audienceId                 String                   @map("audience_id")
  redirectUri                String                   @map("redirect_uri")
  status                     AuthorizationCodeStatus  @default(active)
  issuedAt                   DateTime                 @default(now()) @map("issued_at")
  expiresAt                  DateTime                 @map("expires_at")
  consumedAt                 DateTime?                @map("consumed_at")
  version                    Int                      @default(1)
  authorizationTransaction   AuthorizationTransaction @relation(fields: [authorizationTransactionId], references: [id])
  user                       User                     @relation(fields: [userId], references: [id])
  humanClient                HumanClient              @relation(fields: [humanClientId], references: [id])
  audience                   AuthAudience             @relation(fields: [audienceId], references: [audienceId])

  @@index([status, expiresAt])
  @@map("authorization_codes")
}

model HumanSession {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  humanClientId      String              @map("human_client_id") @db.Uuid
  tokenFamilyId      String?             @unique @map("token_family_id") @db.Uuid
  status             HumanSessionStatus  @default(active)
  authenticatedAt    DateTime            @map("authenticated_at")
  lastRefreshedAt    DateTime            @map("last_refreshed_at")
  absoluteExpiresAt  DateTime            @map("absolute_expires_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  revokedAt          DateTime?           @map("revoked_at")
  revocationReason   String?             @map("revocation_reason")
  version            Int                 @default(1)
  user               User                @relation(fields: [userId], references: [id])
  humanClient        HumanClient         @relation(fields: [humanClientId], references: [id])
  tokenFamily        RefreshFamily?      @relation("SessionCurrentFamily", fields: [tokenFamilyId], references: [id])
  families           RefreshFamily[]     @relation("FamilySession")
  refreshCredentials RefreshCredential[]

  @@index([userId, humanClientId, status])
  @@map("human_sessions")
}

model RefreshFamily {
  id                String              @id @default(uuid()) @db.Uuid
  humanSessionId    String              @map("human_session_id") @db.Uuid
  status            RefreshFamilyStatus @default(active)
  createdAt         DateTime            @default(now()) @map("created_at")
  absoluteExpiresAt DateTime            @map("absolute_expires_at")
  revokedAt         DateTime?           @map("revoked_at")
  revokeReason      String?             @map("revoke_reason")
  version           Int                 @default(1)
  humanSession      HumanSession        @relation("FamilySession", fields: [humanSessionId], references: [id])
  currentForSession HumanSession?       @relation("SessionCurrentFamily")
  credentials       RefreshCredential[]

  @@index([humanSessionId, status])
  @@map("refresh_families")
}

model RefreshCredential {
  id                        String                  @id @default(uuid()) @db.Uuid
  familyId                  String                  @map("family_id") @db.Uuid
  sessionId                 String                  @map("session_id") @db.Uuid
  userId                    String                  @map("user_id") @db.Uuid
  humanClientId             String                  @map("human_client_id") @db.Uuid
  secretVerifier            String                  @map("secret_verifier")
  verifierParametersVersion String                  @map("verifier_parameters_version")
  status                    RefreshCredentialStatus @default(active)
  issuedAt                  DateTime                @default(now()) @map("issued_at")
  expiresAt                 DateTime                @map("expires_at")
  rotatedAt                 DateTime?               @map("rotated_at")
  replacedById              String?                 @unique @map("replaced_by_id") @db.Uuid
  revokedAt                 DateTime?               @map("revoked_at")
  reuseDetectedAt           DateTime?               @map("reuse_detected_at")
  version                   Int                     @default(1)
  family                    RefreshFamily           @relation(fields: [familyId], references: [id])
  session                   HumanSession            @relation(fields: [sessionId], references: [id])
  user                      User                    @relation(fields: [userId], references: [id])
  humanClient               HumanClient             @relation(fields: [humanClientId], references: [id])
  replacedBy                RefreshCredential?      @relation("RefreshReplacement", fields: [replacedById], references: [id])
  replaces                  RefreshCredential?      @relation("RefreshReplacement")

  @@index([familyId, status])
  @@index([sessionId, status])
  @@map("refresh_credentials")
}

model TokenExchangeAudit {
  exchangeId           String              @id @default(uuid()) @map("exchange_id") @db.Uuid
  result               ExchangeAuditResult
  originalPrincipalId  String?             @map("original_principal_id") @db.Uuid
  originalClientId     String?             @map("original_client_id")
  proxyPrincipalId     String?             @map("proxy_principal_id") @db.Uuid
  proxyClientId        String?             @map("proxy_client_id")
  sourceTokenJti       String?             @map("source_token_jti")
  delegatedTokenJti    String?             @map("delegated_token_jti")
  sourceAudience       String?             @map("source_audience")
  targetAudience       String?             @map("target_audience")
  requestedScopes      Json?               @map("requested_scopes")
  grantedScopes        Json?               @map("granted_scopes")
  rejectionCategory    String?             @map("rejection_category")
  requestCorrelationId String              @map("request_correlation_id")
  timestamp            DateTime            @default(now())

  @@index([timestamp])
  @@index([sourceTokenJti])
  @@index([delegatedTokenJti])
  @@map("token_exchange_audits")
}

model AuthSecurityAudit {
  id                   String   @id @default(uuid()) @db.Uuid
  eventType            String   @map("event_type")
  result               String
  userId               String?  @map("user_id") @db.Uuid
  humanClientId        String?  @map("human_client_id") @db.Uuid
  humanSessionId       String?  @map("human_session_id") @db.Uuid
  refreshFamilyId      String?  @map("refresh_family_id") @db.Uuid
  credentialId         String?  @map("credential_id") @db.Uuid
  requestCorrelationId String?  @map("request_correlation_id")
  details              Json?
  timestamp            DateTime @default(now())

  @@index([timestamp])
  @@map("auth_security_audits")
}

model GrantChangeAudit {
  id                    String          @id @default(uuid()) @map("change_id") @db.Uuid
  migrationId           String          @map("migration_id")
  sourceGitCommit       String          @map("source_git_commit")
  operatorId            String          @map("operator_id")
  approvalRef           String          @map("approval_ref")
  reason                String
  clientId              String          @map("client_id")
  changeType            GrantChangeType @map("change_type")
  expectedGrantVersion  Int?            @map("expected_grant_version")
  resultingGrantVersion Int             @map("resulting_grant_version")
  beforeValue           Json?           @map("before_value")
  afterValue            Json?           @map("after_value")
  timestamp             DateTime        @default(now())
  @@unique([migrationId, clientId, changeType])
  @@index([timestamp])
  @@map("grant_change_audits")
}

/// Rotation receipt ledger (MACHINE_CLIENT_CREDENTIALS_V0 Amendment A §11).
/// Append-only; intentionally no FK to MachineClient so receipts survive
/// client deletion. operation_id UNIQUE ⇒ replay of a known rotation
/// operation never mutates a second time (bounded-transaction T10).
model MachineClientRotation {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId          String   @unique @map("operation_id")
  machineClientId      String   @map("machine_client_id") @db.Uuid
  clientId             String   @map("client_id")
  preimageFingerprint  String   @map("preimage_fingerprint")
  postimageFingerprint String   @map("postimage_fingerprint")
  rotatedBy            String   @map("rotated_by")
  rotatedAt            DateTime @map("rotated_at") @db.Timestamp(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  @@map("machine_client_rotations")
}


enum AgentIdentityState {
  unresolved
  canonical
  legacy
  retired
}

model AgentIdentityLifecycle {
  principalId String @id @map("principal_id") @db.Uuid
  state AgentIdentityState
  revision BigInt
  evidenceRef String @map("evidence_ref")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  principal MachinePrincipal @relation(fields: [principalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@map("agent_identity_lifecycle")
}

model AgentIdentitySuccessor {
  sourcePrincipalId String @id @map("source_principal_id") @db.Uuid
  targetPrincipalId String @map("target_principal_id") @db.Uuid
  evidenceRef String @map("evidence_ref")
  createdAt DateTime @default(now()) @map("created_at")
  source MachinePrincipal @relation("IdentitySource", fields: [sourcePrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  target MachinePrincipal @relation("IdentityTarget", fields: [targetPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([targetPrincipalId], map: "agent_identity_successors_target_idx")
  @@map("agent_identity_successors")
}

enum CanonicalSubjectType {
  agent
  human
  service
}

enum SubjectAttestationStatus {
  active
  superseded
  revoked
}

enum AttestationActorKind {
  user
  machine_principal
  external_authority
}

enum AttestationAuthorityKind {
  owner_exact
  delegated
  accepted_governing_authority
}

enum AttestationAuthorityOperation {
  activate
  supersede
  revoke
}

enum SourceBindingSemantics {
  prospective_binding
}

enum SourceBindingStatus {
  planned
  active
  superseded
  exited
}

enum DelegatedActorType {
  user
  machine_principal
}

enum IdentityAttestationDelegationStatus {
  active
  revoked
}

model IdentityAttestationDelegation {
  delegationId String @id @map("delegation_id") @db.Uuid
  delegatedActorType DelegatedActorType @map("delegated_actor_type")
  delegatedUserId String? @map("delegated_user_id") @db.Uuid
  delegatedMachinePrincipalId String? @map("delegated_machine_principal_id") @db.Uuid
  authorizedSubjectType CanonicalSubjectType @map("authorized_subject_type")
  authorizedBusinessSubjectIds String[] @map("authorized_business_subject_ids") @db.Uuid
  authorizedOperations String[] @map("authorized_operations")
  ownerAuthorityRef String @map("owner_authority_ref")
  ownerAuthorityDigest String @map("owner_authority_digest")
  effectiveAt DateTime @map("effective_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  status IdentityAttestationDelegationStatus @default(active)
  revision BigInt
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationAuthorityRef String? @map("revocation_authority_ref")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  delegatedUser User? @relation(fields: [delegatedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  delegatedMachinePrincipal MachinePrincipal? @relation(fields: [delegatedMachinePrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attestations CanonicalSubjectAttestation[]
  operationAuthorities CanonicalSubjectOperationAuthority[]

  @@map("identity_attestation_delegations")
}

model CanonicalSubjectAttestation {
  subjectAttestationId String @id @map("subject_attestation_id") @db.Uuid
  businessSubjectId String @map("business_subject_id") @db.Uuid
  subjectType CanonicalSubjectType @map("subject_type")
  businessSubjectDescription String @map("business_subject_description")
  machinePrincipalId String? @map("machine_principal_id") @db.Uuid
  userId String? @map("user_id") @db.Uuid
  canonicalAgentId String? @map("canonical_agent_id")
  authoritySource String @map("authority_source")
  attestedByKind AttestationActorKind @map("attested_by_kind")
  attestedByUserId String? @map("attested_by_user_id") @db.Uuid
  attestedByMachinePrincipalId String? @map("attested_by_machine_principal_id") @db.Uuid
  attestedByExternalRef String? @map("attested_by_external_ref")
  attestationAuthorityKind AttestationAuthorityKind @map("attestation_authority_kind")
  attestationAuthorityRef String @map("attestation_authority_ref")
  attestationAuthorityDigest String @map("attestation_authority_digest")
  attestationAuthorityOperation AttestationAuthorityOperation @map("attestation_authority_operation")
  delegationId String? @map("delegation_id") @db.Uuid
  effectiveAt DateTime @map("effective_at") @db.Timestamptz(3)
  evidenceRef String @map("evidence_ref")
  supersedesAttestationId String? @unique @map("supersedes_attestation_id") @db.Uuid
  revision BigInt
  status SubjectAttestationStatus
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  machinePrincipal MachinePrincipal? @relation("CanonicalSubjectMachine", fields: [machinePrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user User? @relation("CanonicalSubjectHuman", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attestedByUser User? @relation("CanonicalSubjectAttestedByUser", fields: [attestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attestedByMachinePrincipal MachinePrincipal? @relation("CanonicalSubjectAttestedByMachine", fields: [attestedByMachinePrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  delegation IdentityAttestationDelegation? @relation(fields: [delegationId], references: [delegationId], onDelete: Restrict, onUpdate: Restrict)
  supersedes CanonicalSubjectAttestation? @relation("CanonicalSubjectAttestationChain", fields: [supersedesAttestationId], references: [subjectAttestationId], onDelete: Restrict, onUpdate: Restrict)
  replacement CanonicalSubjectAttestation? @relation("CanonicalSubjectAttestationChain")
  sourceBindings CanonicalSubjectSourceBinding[]

  @@map("canonical_subject_attestations")
}

model CanonicalSubjectSourceBinding {
  sourceBindingId String @id @map("source_binding_id") @db.Uuid
  sourceNamespace String @map("source_namespace")
  sourceLocalValue String @map("source_local_value")
  subjectAttestationId String @map("subject_attestation_id") @db.Uuid
  semantics SourceBindingSemantics @default(prospective_binding)
  effectiveAt DateTime @map("effective_at") @db.Timestamptz(3)
  evidenceRef String @map("evidence_ref")
  status SourceBindingStatus
  revision BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(3)
  supersessionEvidenceRef String? @map("supersession_evidence_ref")
  exitedAt DateTime? @map("exited_at") @db.Timestamptz(3)
  exitEvidenceRef String? @map("exit_evidence_ref")
  supersedesSourceBindingId String? @unique @map("supersedes_source_binding_id") @db.Uuid
  subjectAttestation CanonicalSubjectAttestation @relation(fields: [subjectAttestationId], references: [subjectAttestationId], onDelete: Restrict, onUpdate: Restrict)
  supersedes CanonicalSubjectSourceBinding? @relation("CanonicalSubjectSourceBindingChain", fields: [supersedesSourceBindingId], references: [sourceBindingId], onDelete: Restrict, onUpdate: Restrict)
  replacement CanonicalSubjectSourceBinding? @relation("CanonicalSubjectSourceBindingChain")

  @@map("canonical_subject_source_bindings")
}

model CanonicalSubjectOperation {
  operationId String @id @map("operation_id") @db.Uuid
  environment String
  actorRef String @map("actor_ref")
  packetDigest String @map("packet_digest")
  authorityDigest String @map("authority_digest")
  prestateDigest String @map("prestate_digest")
  planDigest String @unique @map("plan_digest")
  coreEvidenceDigest String? @map("core_evidence_digest")
  attestationAuthorityManifestDigest String @map("attestation_authority_manifest_digest")
  poststateDigest String @map("poststate_digest")
  mutationCounts Json @map("mutation_counts")
  committedAt DateTime @default(now()) @map("committed_at") @db.Timestamptz(3)
  authorityManifest CanonicalSubjectOperationAuthority[]

  @@map("canonical_subject_operations")
}

model CanonicalSubjectOperationAuthority {
  operationId String @map("operation_id") @db.Uuid
  mutationKey String @map("mutation_key")
  businessSubjectId String @map("business_subject_id") @db.Uuid
  subjectAttestationId String @map("subject_attestation_id") @db.Uuid
  predecessorId String? @map("predecessor_id") @db.Uuid
  subjectType CanonicalSubjectType @map("subject_type")
  target Json
  authorityKind AttestationAuthorityKind @map("authority_kind")
  authorityRef String @map("authority_ref")
  authorityDigest String @map("authority_digest")
  requestedOperation AttestationAuthorityOperation @map("requested_operation")
  intendedDisposition SubjectAttestationStatus @map("intended_disposition")
  delegationId String? @map("delegation_id") @db.Uuid
  delegationRevision BigInt? @map("delegation_revision")
  operation CanonicalSubjectOperation @relation(fields: [operationId], references: [operationId], onDelete: Restrict, onUpdate: Restrict)
  delegation IdentityAttestationDelegation? @relation(fields: [delegationId], references: [delegationId], onDelete: Restrict, onUpdate: Restrict)

  @@id([operationId, mutationKey])
  @@map("canonical_subject_operation_authorities")
}

/// T86 (WF-GS-10/AUTH-SCOUT-20260914-C04): durable single-consumption ledger
/// for refresh-token rotation. The jti PRIMARY KEY is the canonical replay
/// identity — INSERT..ON CONFLICT DO NOTHING decides the atomic winner, so
/// consumption is durable across process restarts and shared across service
/// instances (replaces the former process-local revokedTokens Map).
model RefreshTokenConsumption {
  jti        String   @id
  consumedAt DateTime @default(now()) @map("consumed_at")
  expiresAt  DateTime @map("expires_at")
  userId     String?  @map("user_id") @db.Uuid

  @@map("refresh_token_consumptions")
}

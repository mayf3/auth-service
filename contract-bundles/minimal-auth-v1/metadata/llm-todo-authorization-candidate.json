  "decision_status": "owner_review_required",
  "audience": "llm-todo",
  "candidate_principal_types": ["user", "agent", "service"],
  "candidate_scopes": ["todo.admin", "todo.invoke", "todo.read", "todo.write"],
  "matching_rule": "most_specific_path_pattern_wins_and_any_tie_denies",
  "route_groups": [
    {

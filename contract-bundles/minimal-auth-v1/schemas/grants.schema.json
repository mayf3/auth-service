{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minimal-auth-v1:grants:1.0.0",
  "title": "Minimal Auth V1 Client Grants and Change Audit",
  "oneOf": [
    { "$ref": "#/$defs/clientGrants" },
    { "$ref": "#/$defs/grantChangeAudit" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "audienceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "scope": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9._-]*$"
    },
    "scopedGrants": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/audienceId" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/scope" }
      }
    },
    "clientGrants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_id": { "type": "string", "minLength": 1 },
        "client_kind": { "enum": ["human", "machine"] },
        "principal_id": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "principal_type": { "enum": ["agent", "service", null] },
        "human_audience_grants": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/audienceId" }
        },
        "machine_access_grants": { "$ref": "#/$defs/scopedGrants" },
        "delegation_grants": { "$ref": "#/$defs/scopedGrants" },
        "status": { "enum": ["active", "revoked"] },
        "version": { "type": "integer", "minimum": 1 }
      },
      "required": [
        "client_id", "client_kind", "principal_id", "principal_type",
        "human_audience_grants", "machine_access_grants",
        "delegation_grants", "status", "version"
      ],
      "allOf": [
        {
          "if": { "type": "object", "properties": { "client_kind": { "const": "human" } } },
          "then": {
            "type": "object",
            "properties": {
              "principal_id": { "type": "null" },
              "principal_type": { "type": "null" },
              "machine_access_grants": { "type": "object", "maxProperties": 0 },
              "delegation_grants": { "type": "object", "maxProperties": 0 }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "principal_id": { "$ref": "#/$defs/uuid" },
              "principal_type": { "enum": ["agent", "service"] },
              "human_audience_grants": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ]
    },
    "grantChangeAudit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "change_id": { "$ref": "#/$defs/uuid" },
        "migration_id": { "type": "string", "minLength": 1 },
        "source_git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "operator_id": { "type": "string", "minLength": 1 },
        "approval_ref": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "client_id": { "type": "string", "minLength": 1 },
        "change_type": { "enum": ["create", "replace", "revoke"] },
        "expected_grant_version": { "type": ["integer", "null"], "minimum": 1 },
        "resulting_grant_version": { "type": "integer", "minimum": 1 },
        "before_value": {
          "oneOf": [{ "$ref": "#/$defs/clientGrants" }, { "type": "null" }]
        },
        "after_value": {
          "oneOf": [{ "$ref": "#/$defs/clientGrants" }, { "type": "null" }]
        },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": [
        "change_id", "migration_id", "source_git_commit", "operator_id",
        "approval_ref", "reason", "client_id", "change_type",
        "expected_grant_version", "resulting_grant_version", "before_value",
        "after_value", "timestamp"
      ]
    }
  }
}

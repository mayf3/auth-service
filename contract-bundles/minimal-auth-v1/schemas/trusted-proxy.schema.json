{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minimal-auth-v1:trusted-proxy:1.0.0",
  "title": "Minimal Auth V1 Trusted Proxy Registration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "proxy_id": { "type": "string", "minLength": 1 },
    "proxy_principal_id": { "$ref": "#/$defs/uuid" },
    "proxy_principal_type": { "const": "service" },
    "proxy_client_id": { "type": "string", "minLength": 1 },
    "accepted_subject_audiences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/audienceId" }
    },
    "delegation_grants": { "$ref": "#/$defs/scopedGrants" },
    "status": { "enum": ["active", "revoked"] },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": [
    "proxy_id", "proxy_principal_id", "proxy_principal_type", "proxy_client_id",
    "accepted_subject_audiences", "delegation_grants", "status", "version",
    "created_at", "updated_at"
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "audienceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "scope": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9._-]*$"
    },
    "scopedGrants": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/audienceId" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/scope" }
      }
    }
  }
}

+  } catch (error) {
+    return {
+      outcome: callbackCompleted ? 'OUTCOME_UNKNOWN' : 'PRECOMMIT_FAILED',
+      reason: `${callbackCompleted ? 'COMMIT_OUTCOME_UNKNOWN' : 'PRECOMMIT_FAILURE'}:${error instanceof Error ? error.message : String(error)}`,

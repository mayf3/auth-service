+    source: { scopes: [...SOURCE_SCOPES], version: SOURCE_VERSION },
+    target: { scopes: [...TARGET_SCOPES], version: TARGET_VERSION },
+    nonce, planSha256: digest(planDocument), preimageDigest: null, bystanderDigest: null, planDocument,
+  };

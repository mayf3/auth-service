+
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (isObject(value)) {
+    return Object.fromEntries(Object.keys(value).sort(asciiCompare).map((key) => [key, canonical(value[key])]));
+  }
+  return value;
